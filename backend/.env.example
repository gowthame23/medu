APP_NAME="Mend"
APP_ENV="development"
DEBUG="true"
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/mend"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ENABLE_SANDBOX_PAYMENTS="true"
EMAIL_PROVIDER="console"
SMS_PROVIDER="console"
SMTP_HOST="localhost"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@mend.local"
SMTP_USE_TLS="true"
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_HOURLY_CAP=5
REQUIRE_EMAIL_VERIFICATION_FOR_PAYMENTS="true"
REQUIRE_PHONE_VERIFICATION_FOR_PAYMENTS="false"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
