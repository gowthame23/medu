# Frontend Configuration
NEXT_PUBLIC_API_URL="/api/v1"
BACKEND_INTERNAL_URL="http://localhost:8000"

# Backend Configuration
APP_NAME="Mend"
APP_ENV="development"
DEBUG="false"
POSTGRES_USER="mend_user"
POSTGRES_PASSWORD="mend_secure_dev_password_2026"
DATABASE_URL="postgresql+asyncpg://mend_user:mend_secure_dev_password_2026@localhost:5432/mend"
DATABASE_URL_SYNC="postgresql://mend_user:mend_secure_dev_password_2026@localhost:5432/mend"

# Cryptographic Keys (Must be >= 32 characters in production)
SECRET_KEY="dev-insecure-secret-key-change-in-production-mend-2026-xyz"
WEBHOOK_SECRET="dev-insecure-webhook-secret-2026-change-in-prod-xyz"

# Payments Configuration
PAYMENT_PROVIDER="SANDBOX_UPI"
ENABLE_SANDBOX_PAYMENTS="true"

# Verification & Notification Providers
EMAIL_PROVIDER="console" # console, smtp
SMS_PROVIDER="console"   # console

# SMTP Configuration (Used when EMAIL_PROVIDER=smtp)
SMTP_HOST="localhost"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@mend.local"
SMTP_USE_TLS="true"

# Verification Policies & Bounds
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_HOURLY_CAP=5

# Payment Gating Policies
REQUIRE_EMAIL_VERIFICATION_FOR_PAYMENTS="true"
REQUIRE_PHONE_VERIFICATION_FOR_PAYMENTS="false"
